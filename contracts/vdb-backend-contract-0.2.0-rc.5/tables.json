  "rc5NewTables": {
    "partner_agreement_versions": {
      "purpose": "Partner agreement catalogue, one current version per agreement family.",
      "rls": "RLS on. anon denied. authenticated may SELECT. Staff may write. No client INSERT/UPDATE grant.",
      "legalWarning": "body_placeholder values are placeholders and legal_review_status is REQUIRED until legal signs off. Nothing here is a binding legal text and it must not be presented as final terms."
    },
    "partner_agreement_acceptances": {
      "purpose": "Immutable record that a partner accepted one agreement version.",
      "writer": "accept_partner_agreement only (SECURITY DEFINER). No client INSERT grant.",
      "rls": "RLS on. anon denied. Partner may SELECT own rows; staff may SELECT all.",
      "uniqueness": "UNIQUE (partner_id, agreement_version_id) — acceptance is idempotent."
    }
  },
  "rc5NewColumns": {
    "partner_applications": [
      "partner_type (partner_type, nullable — NULL means the applicant predates typed intake; never inferred from kvk_number)",
      "staff_approved_at (timestamptz)",
      "staff_approved_by (uuid -> profiles.id)"
    ],
    "partner_profiles": [
      "partner_type (partner_type, nullable)",
      "type_classification_status (partner_type_classification_status, NOT NULL DEFAULT 'UNKNOWN')",
      "age_verification_status (partner_verification_status, NOT NULL DEFAULT 'NOT_STARTED')",
      "age_verified_at (timestamptz)",
      "age_verification_source (text — provenance label only, never document data)",
      "age_verification_expires_at (timestamptz)",
      "identity_verification_status (partner_verification_status, NOT NULL DEFAULT 'NOT_STARTED')",
      "identity_verified_at (timestamptz)",
      "identity_verification_provider_ref (text — opaque provider reference, never document contents or numbers)",
      "business_verification_status (partner_verification_status, NOT NULL DEFAULT 'NOT_STARTED')",
      "business_verified_at (timestamptz)",
      "business_verification_provider_ref (text)",
      "payout_profile_status (partner_payout_profile_status, NOT NULL DEFAULT 'NOT_STARTED')",
      "payout_profile_updated_at (timestamptz)",
      "staff_approved_at (timestamptz)",
      "staff_approved_by (uuid -> profiles.id)",
      "legacy_activation_grandfathered (boolean, NOT NULL DEFAULT false — true for partners already ACTIVE before rc.5)",
      "activation_block_codes (text[], NOT NULL DEFAULT '{}' — diagnostic only, never an authorization source)",
      "required_agreement_type (partner_agreement_type)",
      "required_agreement_version (text)"
    ]
  },
