# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000
# Backwards-compatible alias for NEXT_PUBLIC_MAIN_SITE_URL
MAIN_SITE_URL=http://localhost:3000
# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_SECRET=replace-with-webhook-secret
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=partners@example.com
BASE_URL=http://127.0.0.1:3000
FORCE_ENV_VALIDATION=false
EMAILS_REQUIRED=false
IDENTITY_PROVIDER=manual
IDENTITY_PROVIDER_API_KEY=replace-with-provider-key
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-16-random-characters
SENTRY_DSN=https://public@example.ingest.sentry.io/1
# Feature flags default to fail-closed. Database feature_flags values override these.
seller_registration_enabled=false
identity_verification_enabled=false
mollie_payments_enabled=false
manual_bank_payments_enabled=false
cash_payouts_enabled=false
bank_payouts_enabled=false
marketing_library_enabled=false
support_enabled=false
international_registration_enabled=false
